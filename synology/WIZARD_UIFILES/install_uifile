                    {
                        "key": "wizard_mode_team",
                        "desc": "Ein Team (Chef/Admin und Mitarbeiter)",
                        "defaultValue": false
                    }
                ]
            },
            {
                "type": "password",
                "desc": "Passwort für den Benutzer <b>admin</b> des Zeitmanagements (mindestens 8 Zeichen). Das ist unabhängig von deinem DSM-Konto – DSM-Administratoren werden im DSM-Fenster auch ohne Passwort angemeldet.",
                "subitems": [
                    {
                        "key": "wizard_admin_password",
                        "desc": "Admin-Passwort",
                        "validator": {
                            "allowBlank": false,
                            "minLength": 8
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Firmenname für Kopfzeile, Anmeldung und Berichte (optional, später änderbar – dort auch das Logo).",
                "subitems": [
                    {
                        "key": "wizard_company",
                        "desc": "Firmenname",
                        "emptyText": "z. B. Muster GmbH",
                        "validator": {
                            "allowBlank": true,
                            "maxLength": 80
                        }
                    }
                ]
            },
            {
                "type": "textfield",
