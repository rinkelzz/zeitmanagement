
# --- postinst: Konfiguration aus dem Assistenten schreiben, Datenbank + Admin anlegen

mkdir -p "${PKGVAR}"

PORT="${wizard_port:-8770}"
case "$PORT" in ''|*[!0-9]*) PORT=8770 ;; esac
# Ports, die DSM selbst braucht, nicht zulassen
case "$PORT" in 80|443|5000|5001|5005|5006|6690|9900|9901) PORT=8770 ;; esac

if [ ! -f "${CONFIG}" ]; then
    {
        echo "# Zeitmanagement – Einstellungen. Nach Änderungen das Paket neu starten."
        echo "# Den Port besser in der App ändern (Verwaltung → System) – dann startet sie selbst neu."
        echo "ZM_PORT=${PORT}"
        echo "ZM_PUBLIC_URL=\"\""
        echo "ZM_ROOT_PATH=\"\""
        echo "ZM_COOKIE_SECURE=0"
        echo "ZM_TIMEZONE=\"Europe/Berlin\""
    } > "${CONFIG}"
fi

MODE=single
[ "${wizard_mode_team:-false}" = "true" ] && MODE=team

set -- $(find_python)
PY="$1"; TAG="$2"
if [ -n "$PY" ]; then
    # Admin-Passwort wird nur hier verwendet und nirgends gespeichert
    ZM_DATA_DIR="${PKGVAR}" ZM_ADMIN_PASSWORD="${wizard_admin_password:-}" \
    ZM_MODE="${MODE}" ZM_COMPANY="${wizard_company:-}" \
    PYTHONPATH="$(lib_path "$PY" "$TAG")" PYTHONDONTWRITEBYTECODE=1 \
        "$PY" -c "from app.db import init_db; init_db()" >> "${LOGFILE}" 2>&1
    log "Installation abgeschlossen (${PY}, Modus ${MODE}, Port ${PORT})"
fi
exit 0
